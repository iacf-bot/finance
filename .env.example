# Copy to .env (Windows: copy .env.example .env). Everything is optional; lines starting with # are ignored.
# Read by the app itself (Windows and Linux), by start.sh and by docker-compose.

# Address(es) to listen on, comma separated. Default 127.0.0.1 (this computer only).
# To use it from your other devices over Tailscale, add this machine's Tailscale IP, e.g.:
# HOST=127.0.0.1,xxx.xxx.xxx.xxx
# HOST=0.0.0.0 listens on every network interface: then restrict access with the firewall (see RUN_ON_WINDOWS.md).
# HOST=127.0.0.1

# Port. Default 8088.
# PORT=8088

# Where finance.db, backups, logs, attachments and secret.key live. Default: the "data" folder next to the app.
# DATA_DIR=data
# DATA_DIR=D:\FinanceData

# Telegram bot (optional)
# TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
# TELEGRAM_ALLOWED_CHAT_IDS=111111111     # your chat id; the bot tells unknown chats their id
